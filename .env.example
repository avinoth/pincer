# Copy to .env and fill in. Loaded in dev/test by dotenv-rails.

# --- Postgres (matches the bundled docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pincer
POSTGRES_PASSWORD=pincer

# --- URLs ---
# Port the API listens on (Puma reads PORT; Procfile.dev defaults to 3001).
PORT=3001
# This API's public base URL (used to build the Slack OAuth redirect_uri).
# In dev, this is your public HTTPS tunnel to localhost:3001 (cloudflared/ngrok),
# e.g. https://your-subdomain.trycloudflare.com — must match the Slack app's
# redirect URIs. Only needed if you're wiring up a real Slack app.
BASE_URL=localhost:3001
# Optional frontend origin (CORS + post-OAuth redirect target). Point this at
# your own web app or leave as-is; no frontend is bundled in this repo.
FRONTEND_URL=http://localhost:3000

# --- Slack app credentials (only needed to run the live Slack loop) ---
# Create your own Slack app from slack-app-manifest.json, then paste its creds.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- LLM (RubyLLM via OpenRouter) ---
OPENROUTER_API_KEY=
# Semantic role -> model slug (optional overrides; sensible defaults in the initializer).
AI_MODEL_LIGHTWEIGHT=openai/gpt-4o-mini
AI_MODEL_STANDARD=openai/gpt-4o
# OpenRouter has more slugs than RubyLLM's registry; keep "true" to allow arbitrary slugs.
AI_ASSUME_MODEL_EXISTS=true

# --- Error tracking (leave blank in dev; only notifies in prod/staging) ---
BUGSNAG_API_KEY=

# --- Admin panel (RailsAdmin + GoodJob dashboard) ---
# Shared HTTP Basic Auth credential gating /admin and /good_job (see
# lib/admin_auth.rb). Blank means both routes fail closed (401), not a
# boot error — set both to reach them locally.
ADMIN_USERNAME=
ADMIN_PASSWORD=
